        <mxCell id="m_rules" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFFFFF;strokeColor=#12365F;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#1a1a1a;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="&lt;b&gt;Business rules&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Requests&lt;/b&gt;&lt;br&gt;• One request per worker per shift.&lt;br&gt;• Applications only for PUBLISHED listings, before the deadline.&lt;br&gt;• A worker cannot apply to their own business.&lt;br&gt;• Only an ACCEPTED request can create a JobAssignment.&lt;br&gt;&lt;b&gt;Assignments&lt;/b&gt;&lt;br&gt;• A worker is assigned to a shift at most once.&lt;br&gt;• Active assignments per shift must not exceed slots.&lt;br&gt;• Only COMPLETED assignments can be rated or paid out.&lt;br&gt;&lt;b&gt;Ratings&lt;/b&gt;&lt;br&gt;• Score is between 1 and 5.&lt;br&gt;• Only the worker and employer of the assignment can rate.&lt;br&gt;• One rating per participant per assignment.&lt;br&gt;&lt;b&gt;Money&lt;/b&gt;&lt;br&gt;• Funds are held in escrow before the shift starts.&lt;br&gt;• Released only after the employer confirms completion.&lt;br&gt;• Commission is deducted on release.&lt;br&gt;&lt;b&gt;Listings&lt;/b&gt;&lt;br&gt;• A listing must be approved by an Administrator before it is PUBLISHED." vertex="1">
          <mxGeometry height="359" width="367" x="1690" y="1533" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
